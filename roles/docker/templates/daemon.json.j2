{
  "registry-mirrors": ["https://docker-cache.markridgwell.com"],
  "icc": false,
  "no-new-privileges": true,
  "userland-proxy": false,
  "firewall-backend": "nftables",
  "ipv6": true,
  "fixed-cidr-v6": "fd00:d0c::/64",
  "default-network-opts": {
    "bridge": {
      "com.docker.network.enable_ipv6": "true"
    }
  },
  "default-ulimits": {
    "core": {
      "Name": "core",
      "Hard": 0,
      "Soft": 0
    }
  },
{% if docker_log_driver == 'journald' %}
  "log-driver": "journald",
  "log-opts": {
    "tag": "{{ '{{' }}.Name{{ '}}' }}"
  }
{% else %}
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "100m",
    "max-file": "3"
  }
{% endif %}
}
