#!/bin/sh
# ansible-pull-reset-checkout <branch>
#
# Run as ExecStartPre of ansible-pull.service (as the autoupdate user).
# The repository is the only source of truth for this host, so anything in
# an ansible-pull checkout that is not on origin/<branch> - local commits,
# edited or stray files, a different branch checked out - is discarded
# before every run. Otherwise one local commit wedges every later run with
# "Unable to advance to origin/<branch> because local commits will be lost".
# What gets discarded is logged to the journal first.
#
# Never fails the unit: on any problem it logs and leaves the checkout for
# ansible-pull to report as before.
set -u
branch="${1:-main}"

for dir in "${HOME}"/.ansible/pull/*/; do
    [ -d "${dir}.git" ] || continue
    if ! git -C "${dir}" fetch --quiet origin "${branch}"; then
        echo "ansible-pull-reset-checkout: fetch failed in ${dir}; leaving it alone" >&2
        continue
    fi
    target="origin/${branch}"
    current="$(git -C "${dir}" symbolic-ref --quiet --short HEAD 2>/dev/null || echo '(detached)')"
    ahead="$(git -C "${dir}" rev-list --count "${target}..HEAD" 2>/dev/null || echo 0)"
    dirty="$(git -C "${dir}" status --porcelain 2>/dev/null | wc -l)"
    if [ "${current}" = "${branch}" ] && [ "${ahead}" -eq 0 ] && [ "${dirty}" -eq 0 ]; then
        continue
    fi
    echo "ansible-pull-reset-checkout: ${dir}: branch ${current}, ${ahead} local commit(s), ${dirty} changed file(s); resetting to ${target}"
    git -C "${dir}" log --oneline "${target}..HEAD" 2>/dev/null | sed 's/^/  discarded commit: /'
    git -C "${dir}" status --short 2>/dev/null | sed 's/^/  discarded change: /'
    git -C "${dir}" checkout --quiet --force -B "${branch}" "${target}" \
        && git -C "${dir}" reset --quiet --hard "${target}" \
        && git -C "${dir}" clean --quiet -fd \
        || echo "ansible-pull-reset-checkout: reset failed in ${dir}" >&2
done
exit 0
