[Unit]
Description=Ansible Pull - automatic system configuration update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=autoupdate
# Discard anything in the checkout that is not on origin/main first, so a
# local commit or edit can never wedge the run (ansible-pull-reset-checkout).
ExecStartPre=/usr/local/libexec/ansible-pull-reset-checkout main
ExecStart=/usr/bin/ansible-pull --full -U https://github.com/credfeto/credfeto-setup-arch-vm.git -C main site.yml
StandardOutput=journal
StandardError=journal
